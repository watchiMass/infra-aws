terraform {
  # >= 1.10 : requis par use_lockfile du backend S3 (verrouillage sans DynamoDB).
  required_version = ">= 1.10"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
    github = {
      source  = "integrations/github"
      version = "~> 6.0"
    }
  }
}
